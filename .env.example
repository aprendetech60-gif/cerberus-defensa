# ============================================================
# CERBERUS V3.5 - Variables de entorno (EJEMPLO)
# ============================================================
# 
# 🔐 NUNCA subas este archivo con secretos reales a GitHub
# 📋 Copia a .env para desarrollo local
# ☁️ Configura en Render para producción
# ============================================================

# ============================================
# ENTORNO
# ============================================

CERBERUS_ENV=production
CERBERUS_LOG_LEVEL=INFO
CERBERUS_DEBUG=false

# ============================================
# BASE DE DATOS (OPCIONAL - NO USAMOS EN RENDER)
# ============================================

# CERBERUS_DATABASE_URL=postgresql+psycopg://cerberus:cerberus@localhost:5432/cerberus
# CERBERUS_DATABASE_POOL_SIZE=10
# CERBERUS_DATABASE_MAX_OVERFLOW=20

# ============================================
# REDIS (OPCIONAL - NO USAMOS EN RENDER)
# ============================================

# CERBERUS_REDIS_URL=redis://localhost:6379/0
# CERBERUS_RATE_LIMIT_ENABLED=true

# ============================================
# SEGURIDAD
# ============================================

CERBERUS_APPROVAL_TTL_SECONDS=300
CERBERUS_FAIL_CLOSED=true
CERBERUS_DRY_RUN=false

# ============================================
# AUDITORÍA
# ============================================

CERBERUS_AUDIT_RETENTION_DAYS=365

# ============================================
# CRIPTOGRAFÍA - COMPLETAR CON VALORES REALES
# ============================================

# 🔑 Genera estas claves con: python tools/generate_keys.py
CERBERUS_PRIVATE_KEY_B64=TU_CLAVE_PRIVADA_AQUI
CERBERUS_PUBLIC_KEY_B64=TU_CLAVE_PUBLICA_AQUI

# ============================================
# API
# ============================================

CERBERUS_API_HOST=0.0.0.0
CERBERUS_API_PORT=8000
CERBERUS_API_WORKERS=4