CERBERUS_API_KEY_ROTATION_INTERVAL=90
CERBERUS_ALLOWED_ORIGINS=
CERBERUS_ALLOWED_METHODS=POST
CERBERUS_ALLOWED_HEADERS=X-API-Key,Content-Type
CERBERUS_API_HOST=0.0.0.0
CERBERUS_API_PORT=8000
CERBERUS_API_WORKERS=1
CERBERUS_BLOCK_DEFAULT_DURATION=30
CERBERUS_REDIS_URL=