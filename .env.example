CERBERUS_ENV=production
CERBERUS_DEBUG=false
CERBERUS_DRY_RUN=false
CERBERUS_FAIL_CLOSED=true
CERBERUS_RATE_LIMIT_ENABLED=true
CERBERUS_RATE_LIMIT_REQUESTS=100
CERBERUS_RATE_LIMIT_WINDOW=60
CERBERUS_DATABASE_URL=sqlite+aiosqlite:///./cerberus.db
